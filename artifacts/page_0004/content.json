  {"id": "givens", "type": "text", "role": "bullet", "text": "given: R = 10 kΩ, C = 100 nF, 5 V step in at t = 0, cap starts at 0 V"},
  {"id": "fig_1", "type": "schematic",
   "components": [
    {"id": "V1", "type": "voltage_source", "label": "$V_{in}$", "at": [0, 1], "orient": "v"},
    {"id": "R1", "type": "resistor", "label": "R", "value": "10 kΩ", "at": [1, 0], "orient": "h"},
    {"id": "C1", "type": "capacitor", "label": "C", "value": "100 nF", "at": [2, 1], "orient": "v"},
    {"id": "GND", "type": "ground", "at": [1, 2]},
    {"id": "OUT", "type": "terminal", "label": "$V_{out}$", "at": [3, 0]}],
   "nets": [
    {"id": "in", "connects": ["V1.a", "R1.a"]},
    {"id": "out", "connects": ["R1.b", "C1.a", "OUT.a"]},
    {"id": "gnd", "connects": ["V1.b", "C1.b", "GND.a"]}]},
  {"id": "sec_1", "type": "text", "role": "bullet", "text": "KCL at out node:"},
  {"id": "eq_1", "type": "math", "latex": "i = \\frac{V_{in} - V_{out}}{R} = C \\frac{dV_{out}}{dt}", "text": "i = (Vin - Vout)/R = C*dVout/dt", "defines": "i"},
  {"id": "eq_2", "type": "math", "latex": "V_{out}(t) = \\frac{1}{C} \\int_0^t i \\, dt", "text": "Vout(t) = (1/C)*integral(i, 0, t)", "defines": "Vout"},
  {"id": "eq_3", "type": "math", "latex": "= V_{in} \\left(1 - e^{-t/\\tau}\\right)", "text": "= Vin*(1 - exp(-t/tau))", "defines": "Vout", "continues": "eq_2"},
  {"id": "eq_4", "type": "math", "latex": "\\tau = RC = 10\\,\\mathrm{k\\Omega} \\cdot 100\\,\\mathrm{nF} = 1\\,\\mathrm{ms}", "text": "tau = R*C = 10e3*100e-9 = 1e-3", "defines": "tau",
   "check": {"vars": {"R": 10e3, "C": 100e-9, "tau": 1e-3}, "rel_tol": 1e-9}},
  {"id": "sec_2", "type": "text", "role": "bullet", "text": "sine in, phasors:"},
  {"id": "eq_5", "type": "math", "latex": "Z_C = \\frac{1}{j \\omega C}", "text": "ZC = 1/(j*w*C)", "defines": "ZC"},
  {"id": "eq_6", "type": "math", "latex": "H(j\\omega) = \\frac{V_{out}}{V_{in}} = \\frac{Z_C}{R + Z_C}", "text": "H(j*w) = Vout/Vin = ZC/(R + ZC)", "defines": "H",
   "check": {"vars": {"R": 10e3, "C": 100e-9, "w": 4321.0, "Vin": 1.0, "ZC": "1/(j*w*C)", "Vout": "ZC/(R + ZC)", "H": "lambda s: 1/(1 + s*R*C)"}}},
  {"id": "eq_7", "type": "math", "latex": "= \\frac{1}{1 + j \\omega RC}", "text": "= 1/(1 + j*w*R*C)", "defines": "H", "continues": "eq_6",
   "check": {"vars": {"R": 10e3, "C": 100e-9, "w": 4321.0, "ZC": "1/(j*w*C)"}}},
  {"id": "eq_8", "type": "math", "latex": "|H(j\\omega)| = \\frac{1}{\\sqrt{1 + (\\omega RC)^2}}", "text": "abs(H(j*w)) = 1/sqrt(1 + (w*R*C)**2)", "defines": "|H|",
   "check": {"vars": {"R": 10e3, "C": 100e-9, "w": 4321.0, "H": "lambda s: 1/(1 + s*R*C)"}}},
  {"id": "eq_9", "type": "math", "latex": "\\boxed{f_c = \\frac{1}{2 \\pi RC} = 159\\,\\mathrm{Hz}}", "text": "fc = 1/(2*pi*R*C) = 159", "defines": "fc",
   "check": {"vars": {"R": 10e3, "C": 100e-9, "fc": 159.15494}, "rel_tol": 0.002}}
 ]
